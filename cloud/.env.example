# Principia Cloud: overrides only. `docker compose up -d` needs no .env.
# The init service generates the master key and the passport admin token into the principia-secrets volume.
# Every variable below is optional; set one only to override the generated or default value.

# The origin your Mac and phone reach (links, cookies, OAuth callbacks). Default: this machine (http://127.0.0.1:8787),
# or the host's own https URL on Render (RENDER_EXTERNAL_URL) and Fly (FLY_APP_NAME), which need no setting.
PRINCIPIA_PUBLIC_URL=
# Public HTTPS in one flag: set both domains (DNS pointing at this machine), then
#   docker compose --profile caddy up -d
# Caddy gets the certificates; the public URLs follow.
PRINCIPIA_DOMAIN=
PASSPORT_DOMAIN=
# 64 hex characters. Wraps every stored secret. Default: /secrets/master.key (generated by init).
PRINCIPIA_MASTER_KEY=
# Where init writes master.key and passport-admin (default /secrets).
PRINCIPIA_SECRETS_DIR=
# Optional, 32+ characters: allows POST /v1/pair/start with this bearer. Without it, pair with `principia-cloud pair`.
PRINCIPIA_ADMIN_TOKEN=
PRINCIPIA_WORKSPACE_NAME=
# Days of run step history kept (default 30).
PRINCIPIA_LOG_RETENTION_DAYS=
# Comma-separated hosts a connector may use even when they resolve to private addresses (internal tools).
PRINCIPIA_CONNECTOR_ALLOW_PRIVATE=
# The user agents run as (default 1001; the control plane runs as root with six capabilities and drops to it).
PRINCIPIA_AGENT_UID=
# embedded = run the Open Passport host inside this container on the cloud's own origin (Render and Fly do this).
PRINCIPIA_PASSPORT=
# The Open Passport host. Compose sets the internal URL to http://passport:8787.
OPEN_PASSPORT_INTERNAL_URL=
# The passport origin ChatGPT, Claude.ai and your Mac reach (https). Default: https://PASSPORT_DOMAIN, else local.
OPEN_PASSPORT_PUBLIC_URL=
# 16+ characters. Default: /secrets/passport-admin (generated by init).
OPEN_PASSPORT_ADMIN_TOKEN=
# Image tags (default latest).
PRINCIPIA_VERSION=
OPEN_PASSPORT_VERSION=
PORT=
HOST=

# Building the images yourself (compose.build.yml): the Open Passport repository to build the host from.
# OPEN_PASSPORT_SRC=../../open-passport
