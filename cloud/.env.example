# Generate: openssl rand -hex 32. Required; never commit .env.
PRINCIPIA_API_TOKEN=
PRINCIPIA_CONCURRENCY=1
PRINCIPIA_TIMEOUT_MS=1800000
# Optional phone control. Create your own bot with BotFather.
TELEGRAM_BOT_TOKEN=
# Both must match the sender. Comma-separated numeric IDs, no usernames.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional API credentials (CLI subscription login is separate).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional shared company MCP gateway (works for prompt and workflow jobs).
# Generate another independent key: openssl rand -hex 32. Keep it to decrypt stored connections.
PRINCIPIA_MCP_MASTER_KEY=
# Absolute path INSIDE container to a private JSON config array. Mount read-only.
PRINCIPIA_MCP_CONFIG=
