<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Principia for iPhone's privacy manifest (docs/IOS.md, TestFlight). No tracking and no data collected: the app talks
  only to the user's own Mac (its Phone server, the address the user pairs with), never to a Principia server, analytics
  or ads. On the phone it keeps the Mac's address and device key in the Keychain, and three preferences in
  UserDefaults (Face ID lock on/off, the last company shown, the push token once allowed), read only by this app.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
