{
  "name": "principia",
  "productName": "Principia",
  "version": "0.1.0",
  "private": true,
  "description": "Run your company with agents, shared tools, memory and workflows — on your Mac or a self-hosted cloud runner.",
  "author": "Vibiz",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -o better-sqlite3,node-pty && (chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true)",
    "rebuild:native": "electron-rebuild -f -o better-sqlite3,node-pty",
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "electron-vite build && npm run -s phone:build",
    "phone:build": "vite build --config vite.phone.config.ts",
    "build:phone-site": "vite build --config vite.phone-site.config.ts",
    "preview:phone-site": "vite preview --config vite.phone-site.config.ts --port 4318",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "verify:native": "electron scripts/verify-native.cjs",
    "verify:memory": "electron-vite build && ELECTRON_RUN_AS_NODE=1 electron scripts/verify-memory-mcp.cjs",
    "verify:hive": "electron-vite build && ELECTRON_RUN_AS_NODE=1 electron scripts/verify-hive-mcp.cjs",
    "dist": "electron-vite build && npm run -s phone:build && node scripts/verify-no-fake-slack.cjs && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --config electron-builder.yml --publish never",
    "release:mac": "node scripts/release-mac.mjs",
    "make:icons": "swift scripts/make-icons.swift && iconutil -c icns build/icon.iconset -o build/icon.icns && rm -rf build/icon.iconset",
    "smoke": "electron-vite build && HIVE_SMOKE=1 HIVE_USER_DATA=.hive-dev-data/smoke electron .",
    "build:fakeslack": "HIVE_BUILD_FAKE_SLACK=1 electron-vite build && node -e \"require('fs').writeFileSync('out-fakeslack/package.json', JSON.stringify({name:'hive-fakeslack',productName:'Hive (fake Slack)',main:'main/index.js'}))\"",
    "verify:slack": "electron-vite build && node scripts/verify-no-fake-slack.cjs",
    "cloud:start": "node cloud/server.mjs",
    "cloud:test": "node --test cloud/*.test.mjs && vitest run src/cloud src/shared/cloud.test.ts",
    "release:prepare": "node scripts/prepare-public-release.mjs",
    "cloud:build": "vite build --config vite.cloud.config.ts",
    "cloud:console:build": "vite build --config vite.console.config.ts",
    "cloud:control:start": "node out-cloud/control.mjs",
    "cloud:control:smoke": "node cloud/control.smoke.mjs",
    "cloud:isolation:smoke": "node cloud/isolation.smoke.mjs",
    "release:test": "node --test scripts/prepare-public-release.test.mjs scripts/release-target.test.mjs",
    "cloud:verify": "npm run cloud:build && ELECTRON_RUN_AS_NODE=1 electron cloud/workflows.smoke.mjs && ELECTRON_RUN_AS_NODE=1 electron cloud/workflows-api.smoke.mjs && ELECTRON_RUN_AS_NODE=1 electron cloud/gateway-workflow.smoke.mjs"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/d3-force": "3.0.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "better-sqlite3": "13.0.3",
    "chokidar": "6.0.0",
    "croner": "10.0.1",
    "d3-force": "3.0.0",
    "electron-updater": "6.8.11",
    "geist": "1.7.2",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "license": "MIT"
}
